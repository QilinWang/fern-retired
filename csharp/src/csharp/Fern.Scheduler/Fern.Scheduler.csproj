<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <Deterministic>true</Deterministic>
    <RootNamespace>Fern.Scheduler</RootNamespace>
    <AssemblyName>Fern.Scheduler</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fern.Scheduler.Tests" />
  </ItemGroup>
  <!-- The checked-commit builder's identity is the SHA-256 of its own source,
       the rule the Rust checker used with include_bytes!. Embedding the file
       makes that digest a property of the shipped assembly rather than of a
       source tree the runtime may not have. -->
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="CliWrap" />
    <ProjectReference Include="..\Fern.Install\Fern.Install.csproj" />
    <ProjectReference Include="..\Fern.Experiment\Fern.Experiment.csproj" />
    <ProjectReference Include="..\Fern.Registry\Fern.Registry.csproj" />
    <ProjectReference Include="..\Fern.RunData\Fern.RunData.csproj" />
    <ProjectReference Include="..\Fern.Site\Fern.Site.csproj" />
  </ItemGroup>
</Project>
