<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="Verify.Xunit" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fern.Install\Fern.Install.csproj" />
    <ProjectReference Include="..\Fern.Scheduler\Fern.Scheduler.csproj" />
    <ProjectReference Include="..\Fern.Registry\Fern.Registry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the pure presentation source is shared, never the executable or its grammar. -->
    <Compile Include="..\Fern.Run.Cli\StepState.cs" Link="StepState.cs" />
    <!-- The governance grammar is data and a table; its wiring to System.CommandLine is not here. -->
    <Compile Include="..\Fern.Run.Cli\GovernGrammar.cs" Link="GovernGrammar.cs" />
    <Compile Include="..\Fern.Run.Cli\ControlPlaneInstall.cs" Link="ControlPlaneInstall.cs" />
    <!-- Fixtures in both assemblies seed through an authority and so both unwrap
         a RegistryResult the same way; shared so there is one definition rather
         than one name with two bodies. The Using keeps its namespace — the one it
         declares in its own project — in scope here, because an extension method
         is only found through its namespace. -->
    <Compile Include="..\Fern.Registry.Tests\FixtureResult.cs" Link="FixtureResult.cs" />
    <Using Include="Fern.Registry.Tests" />
  </ItemGroup>
  <Target Name="BuildTerminalAdaptersForProcessContracts" BeforeTargets="Build">
    <MSBuild Projects="..\Fern.Site.Cli\Fern.Site.Cli.csproj;..\Fern.Run.Cli\Fern.Run.Cli.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
