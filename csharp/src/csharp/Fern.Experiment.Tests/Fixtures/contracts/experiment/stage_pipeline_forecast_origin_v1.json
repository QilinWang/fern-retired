{
  "schema": "fern.stage_pipeline_template.v1",
  "stages": [
    {
      "id": "materialize",
      "handler": "serie.materialize.cell",
      "runner": "python_module",
      "entrypoint": "fr_tr",
      "parameters": {},
      "inputs": {
        "training_worker_request": {
          "source": { "kind": "external_artifact" },
          "materialization_requirement": "bytes_required",
          "role": "training_worker_request",
          "schema_id": "fern.training_worker_request.v1"
        },
        "generated_dataset": {
          "source": { "kind": "external_artifact" },
          "materialization_requirement": "bytes_required",
          "role": "generated_dataset",
          "schema_id": "serie.dgp_bank_safetensors.v1"
        }
      },
      "outputs": {
        "materialized_cell": {
          "role": "materialized_cell",
          "schema_id": "serie.materialized_cell_safetensors.v1"
        }
      }
    },
    {
      "id": "train",
      "handler": "fern.train.current",
      "runner": "python_module",
      "entrypoint": "fr_tr",
      "parameters": {},
