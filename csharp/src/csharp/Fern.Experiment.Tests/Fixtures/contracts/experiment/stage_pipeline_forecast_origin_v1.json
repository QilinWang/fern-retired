          },
          "materialization_requirement": "bytes_required",
          "role": "materialized_cell",
          "schema_id": "serie.materialized_cell_safetensors.v1"
        }
      },
      "outputs": {
        "raw_forecast": {
          "role": "raw_forecast",
          "schema_id": "fern.raw_forecast.v1"
        },
        "postprocess_spec": {
          "role": "postprocess_spec",
          "schema_id": "fern.postprocess_spec.v1"
        },
        "model_checkpoint": {
          "role": "model_checkpoint",
          "schema_id": "fern.model_checkpoint_safetensors.v1"
        }
      }
    },
    {
      "id": "postprocess",
      "handler": "fern.postprocess",
      "runner": "python_module",
      "entrypoint": "fr_tr",
      "parameters": {},
      "inputs": {
        "raw_forecast": {
          "source": {
            "kind": "stage_output",
            "stage_id": "train",
            "output": "raw_forecast"
