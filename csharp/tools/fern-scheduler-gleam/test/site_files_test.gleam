pub fn a_second_update_changes_nothing_even_from_a_newer_binary_test() {
  let assert Some(rendered) = site_files.render_unit(declared(), inputs())
  // The same unit rendered by a newer binary differs only in its first line.
  let written =
    string.replace(
      rendered,
      "# Generated for a test",
      "# Generated by an older fern-run",
    )
  let observed =
    Observed(
      ..beijing("50300"),
      unit: Some(FileText("~/.config/systemd/user/" <> unit, written)),
      drop_ins: [],
    )
  let assert Ok(update) =
    site_files.update_unit(declared(), observed, inputs(), False)
  assert !update.write
  assert !update.reload
  assert update.remove == []
  // And the check reads the rendered unit's runtime binary as declared.
  let findings = site_files.check(Ok(declared()), observed, unit)
  assert !list.any(findings, fn(finding) {
    case finding {
      Differs(_, "runtime binary on the Site", _, _) -> True
      Differs(_, "--fern-run", _, _) -> True
      _ -> False
    }
  })
}

