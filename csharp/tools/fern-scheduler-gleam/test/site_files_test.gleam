}

// ── Slice F4: each SSH use and its connection ────────────────────────────

pub fn the_tunnel_never_shares_and_asks_for_the_forward_once_test() {
  // The entry in effect today carries the forward: the tunnel adds none.
  let today =
    site_files.ssh_options(
      site_files.Tunnel,
      declared(),
      site_files.EntryWithForward,
    )
  assert list.contains(today, #("ControlMaster", "no"))
  assert list.contains(today, #("ControlPath", "none"))
  assert !list.any(today, fn(pair) { pair.0 == "RemoteForward" })
  // Once the entry drops it, the tunnel carries it itself.
  let after =
    site_files.ssh_options(
      site_files.Tunnel,
      declared(),
      site_files.EntryWithoutForward,
    )
  assert list.contains(after, #(
    "RemoteForward",
    "127.0.0.1:8622 127.0.0.1:8621",
  ))
  assert list.contains(after, #("ExitOnForwardFailure", "yes"))
  assert list.contains(after, #("ServerAliveCountMax", "3"))
  // As argv the forward's value is one word, whatever it contains.
  assert list.contains(
    site_files.ssh_command(
      "ssh",
      site_files.Tunnel,
      declared(),
      site_files.EntryWithoutForward,
      [],
    ),
    "RemoteForward=127.0.0.1:8622 127.0.0.1:8621",
  )
}

pub fn short_uses_ask_for_no_forward_and_share_only_when_declared_test() {
  list.each(
    [site_files.SupervisorControl, site_files.Check, site_files.Copy],
    fn(purpose) {
      let options =
        site_files.ssh_options(purpose, declared(), site_files.EntryWithForward)
      assert list.contains(options, #("ClearAllForwardings", "yes"))
      assert !list.any(options, fn(pair) { pair.0 == "RemoteForward" })
      // Beijing declares a control path: short commands share it for a minute.
      assert list.contains(options, #(
        "ControlPath",
        "/tmp/fern-beijing-compressed-%C",
      ))
      assert list.contains(options, #("ControlPersist", "60"))
    },
  )
  let unshared =
    site_files.ssh_options(
      site_files.Check,
      site_files.Declaration(..declared(), ssh_control_path: None),
      site_files.EntryWithForward,
    )
  assert list.contains(unshared, #("ControlMaster", "no"))
}

