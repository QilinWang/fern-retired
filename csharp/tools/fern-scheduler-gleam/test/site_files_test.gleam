fn named_paths_ask(supervisor_text: String) -> String {
  json.to_string(
    json.object([
      #("id", json.string("n")),
      #("ask", json.string("named_paths")),
      #("roots", json.array(["/root/bin", deploy], json.string)),
      #(
        "loaded",
        json.array([Nil], fn(_) {
          json.object([
            #("name", json.string("fern-supervisor-local-newcompiler.service")),
            #("temporary", json.bool(True)),
            #("active_state", json.string("active")),
            #("sub_state", json.string("running")),
            #("need_daemon_reload", json.bool(False)),
            #(
              "exec_start",
              json.array(
                [[deploy <> "/compile-binaries/fern-compile.888e83de"]],
                fn(words) { json.array(words, json.string) },
              ),
            ),
            #("environment", json.object([])),
          ])
        }),
      ),
      #(
        "declarations",
        json.array([Nil], fn(_) {
          json.object([
            #("profile", json.string(profile)),
            #("supervisor", json.string(supervisor_text)),
          ])
        }),
      ),
    ]),
  )
}

pub fn the_named_paths_ask_answers_units_and_declarations_test() {
  let line = named_paths_ask(supervisor)
  assert site_files_wire.claims(line)
  let assert Ok(said) = site_files_wire.answer(line)
  assert json.parse(
