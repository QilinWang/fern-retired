pub fn a_unit_still_passing_a_source_compiler_is_a_difference_the_update_repairs_test() {
  // Installed sources were retired on 2026-09-26 and run-study-cells no
  // longer accepts --source-compiler: a unit that still passes one will not
  // start, so the check expects none, as it expects no --study.
  let pair = "/root/work/implementation/d99f=/root/bin/fern-compile.6537"
  let with_pair = start("", "8622", "") <> " --source-compiler " <> pair
  let observed = beijing("50300")
  let lane =
    FileText(
      unit <> ".d/zzzzzz-new-lane.conf",
      "[Service]\nExecStart=\nExecStart=" <> with_pair <> "\n",
    )
  let with_lane =
    Observed(..observed, drop_ins: list.append(observed.drop_ins, [lane]))
  let own =
    Differs(unit <> " with its drop-ins", "--source-compiler", "(none)", pair)
  assert list.contains(site_files.check(Ok(declared()), with_lane, unit), own)
  assert site_files.describe(own)
    == unit
    <> " with its drop-ins: --source-compiler is declared as (none) and found as "
    <> pair
    <> "; run-study-cells no longer accepts --source-compiler, so a unit that still passes it will not start, and update-site-files writes the unit without it"
  // The update is not refused for it: it writes the unit without it.
  let assert Ok(update) =
    site_files.update_unit(declared(), with_lane, inputs(), True)
  assert list.contains(update.changes, #("--source-compiler", pair, "(none)"))
  assert !string.contains(update.text, "--source-compiler")
  // Another unit serving the Site that still passes one is told the same.
  let recovery =
    LoadedUnit(
      name: "fern-supervisor-bj5090-recovery.service",
      temporary: True,
      active_state: "active",
      sub_state: "running",
      need_daemon_reload: False,
      exec_start: [string.split(with_pair, " ")],
      environment: [
        #("RUNPOD_SSH_TARGET", "fern-autodl-bj-5090:50300"),
        #("RUNPOD_COMMAND_TIMEOUT_SECONDS", "1040000"),
        #("RUNPOD_CONTROL_PATH", "/tmp/fern-beijing-compressed-%C"),
      ],
      restarts: 0,
    )
  let other =
    site_files.LoadedDiffers(
      "fern-supervisor-bj5090-recovery.service",
      "--source-compiler",
      "(none)",
      pair,
    )
  assert list.contains(
    site_files.check(
      Ok(declared()),
      Observed(..beijing("50300"), loaded: [recovery]),
      unit,
    ),
    other,
  )
  assert site_files.describe(other)
    == "fern-supervisor-bj5090-recovery.service runs with --source-compiler "
    <> pair
    <> ", where the declaration says (none); run-study-cells no longer accepts --source-compiler, so a unit that still passes it will not start"
}

