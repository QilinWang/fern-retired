      "/root/bin/fern-compile.b68b",
    ])
  assert json.parse(
      said,
      decode.at(["answer", "unread"], decode.list(decode.string)),
    )
    == Ok([])
}

pub fn an_unreadable_declaration_is_named_so_the_caller_cleans_nothing_test() {
  let assert Ok(said) =
