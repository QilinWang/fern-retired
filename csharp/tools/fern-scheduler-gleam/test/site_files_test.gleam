//// shaped like the Beijing RTX 5090's on 2026-09-25.

import fern_scheduler/site_files.{
  type Observed, AlsoServes, CarriesStudies, Differs, Extra, FileText,
  KeptByHand, LoadedOlder, LoadedUnit, Matches, Missing,
  MovesOutputAwayFromJournal, Observed, ReplacesStartCommand, Undeclared,
}
import fern_scheduler/site_files_wire
import gleam/dynamic/decode
import gleam/json
import gleam/list
import gleam/option.{None, Some}
import gleam/string
import gleeunit

pub fn main() -> Nil {
  gleeunit.main()
}

const profile = "{\"schema\":\"fern.execution_profile.v5\",\"profile_id\":\"autodl-bj-5090\",\"executor\":\"ssh\",\"ssh_destination\":\"root@site-b2.example.invalid:50300\",\"python\":\"/root/fern-runtime/home/.venv/bin/python\",\"work_root\":\"/root/work\",\"device\":\"cuda\"}"

const supervisor = "{\"schema\":\"fern.site_supervisor.v1\",\"site\":\"autodl-bj-5090\",\"remote_forward\":{\"site_port\":8622,\"home_port\":8621},\"ssh_compression\":true,\"ssh_control_path\":\"/tmp/fern-beijing-compressed-%C\",\"ssh_command_timeout_seconds\":1040000,\"fern_run\":\"/root/bin/fern-run.8e41\",\"fern_compile\":\"/root/bin/fern-compile.b68b\",\"process_environment\":{\"OMP_NUM_THREADS\":\"1\",\"DOTNET_PROCESSOR_COUNT\":\"2\"},\"cell_timeout_seconds\":86400,\"lease_seconds\":600,\"restart\":\"always\",\"restart_seconds\":15}"

const unit = "fern-study-supervisor-autodl-bj-5090.service"

fn declared() -> site_files.Declaration {
  let assert Ok(declaration) = site_files.declare(profile, supervisor)
  declaration
}

fn start(port: String, home: String, study: String) -> String {
  "/home/user/study/scripts/connect_runpod_ssh.sh stdio -- env DOTNET_PROCESSOR_COUNT=2 OMP_NUM_THREADS=1 /root/bin/fern-run.8e41 run-study-cells --serve --home http://127.0.0.1:"
  <> home
  <> "/ --site autodl-bj-5090 --python /root/fern-runtime/home/.venv/bin/python --fern-run /root/bin/fern-run.8e41 --fern-compile /root/bin/fern-compile.b68b --work-root /root/work --cell-timeout-seconds 86400 --lease-seconds 600"
  <> study
  <> port
}

/// The base unit install-supervisor-service wrote for running on the Site,
/// and three drop-ins like the Beijing Site's: one queueing Studies, one
/// moving output to a file, one replacing the start command last.
fn beijing(port: String) -> Observed {
  Observed(
    ssh_include: None,
    ssh_config: Some(FileText(
      "~/.ssh/config",
      "Host fern-autodl-bj-5090\n    HostName site-b2.example.invalid\n    User root\n    Port "
        <> port
        <> "\n    Compression yes\n    RemoteForward 127.0.0.1:8622 127.0.0.1:8621\n    ExitOnForwardFailure yes\n",
    )),
    unit: Some(FileText(
      "~/.config/systemd/user/" <> unit,
      "# Generated by fern-run install-supervisor-service; do not hand-edit.\n[Service]\nType=simple\nExecStart=/root/bin/fern-run.8e41 run-study-cells --serve --home http://127.0.0.1:8621/ --site autodl-bj-5090\nRestart=on-failure\nRestartSec=5s\n",
    )),
    drop_ins: [
      FileText(
        unit <> ".d/oracle-neighbours.conf",
        "[Service]\nType=oneshot\nEnvironment=RUNPOD_SSH_TARGET=fern-autodl-bj-5090:"
          <> port
          <> "\nExecStart=\nExecStart=-"
          <> start("", "8621", " --study 566")
          <> "\nExecStart=-"
          <> start("", "8621", " --study 567")
          <> "\n",
      ),
      FileText(
        unit <> ".d/zzzz-beta-nll.conf",
        "[Service]\nType=simple\nEnvironment=RUNPOD_SSH_TARGET=fern-autodl-bj-5090:"
          <> port
          <> "\nEnvironment=RUNPOD_COMMAND_TIMEOUT_SECONDS=1040000\nEnvironment=RUNPOD_CONTROL_PATH=/tmp/fern-beijing-compressed-%%C\nRestartSec=15s\nStandardOutput=append:/home/user/study/tmp/beijing.log\nStandardError=append:/home/user/study/tmp/beijing.log\n",
      ),
      FileText(
        unit <> ".d/zzzzz-head-splines.conf",
        "[Service]\nRestart=always\nExecStart=\nExecStart="
          <> start("", "8622", "")
          <> "\n",
      ),
    ],
    loaded: [],
  )
}

pub fn a_moved_port_is_named_where_it_still_differs_test() {
  let findings = site_files.check(Ok(declared()), beijing("27464"), unit)
  assert list.contains(
    findings,
    Differs("~/.ssh/config", "ssh Port", "50300", "27464"),
  )
  assert list.contains(
    findings,
    Differs(
      unit <> " with its drop-ins",
      "RUNPOD_SSH_TARGET",
      "fern-autodl-bj-5090:50300",
      "fern-autodl-bj-5090:27464",
    ),
  )
  // Nothing else in the SSH entry differs: only the port moved.
  assert list.filter(findings, fn(finding) {
      case finding {
        Differs("~/.ssh/config", _, _, _) -> True
        _ -> False
      }
    })
    == [Differs("~/.ssh/config", "ssh Port", "50300", "27464")]
}

pub fn every_drop_in_is_extra_and_says_what_it_changes_test() {
  let findings = site_files.check(Ok(declared()), beijing("50300"), unit)
  let assert Ok(Extra(_, oracle)) =
    list.find(findings, fn(finding) {
      case finding {
        Extra(path, _) -> string.ends_with(path, "oracle-neighbours.conf")
        _ -> False
      }
    })
  assert list.contains(oracle, ReplacesStartCommand)
  assert list.contains(oracle, CarriesStudies(2))
  let assert Ok(Extra(_, output)) =
    list.find(findings, fn(finding) {
      case finding {
        Extra(path, _) -> string.ends_with(path, "zzzz-beta-nll.conf")
        _ -> False
      }
    })
  assert list.contains(
    output,
    MovesOutputAwayFromJournal("append:/home/user/study/tmp/beijing.log"),
  )
  assert list.contains(
    findings,
    Differs(
      unit <> " with its drop-ins",
      "output",
      "journal",
      "append:/home/user/study/tmp/beijing.log",
    ),
  )
  // The command in effect is the last drop-in's, which serves every Study.
  assert !list.any(findings, fn(finding) {
    case finding {
      Differs(_, "--study", _, _) | Differs(_, "--home", _, _) -> True
      _ -> False
    }
  })
  assert list.contains(findings, Missing("~/.ssh/fern-sites.config"))
  assert list.contains(
    findings,
    KeptByHand("~/.ssh/config", "fern-autodl-bj-5090"),
  )
}

pub fn a_drop_in_that_runs_studies_before_the_start_says_so_test() {
  let mechanisms =
    FileText(
      unit <> ".d/zz-fern-mechanisms.conf",
      "[Service]\nExecStartPre=-" <> start("", "8621", " --study 554") <> "\n",
    )
  let findings =
    site_files.check(
      Ok(declared()),
      Observed(..beijing("50300"), drop_ins: [mechanisms]),
      unit,
    )
  assert list.contains(
    findings,
    Extra(unit <> ".d/zz-fern-mechanisms.conf", [
      site_files.RunsBeforeStart(1, 1),
    ]),
  )
}

pub fn a_unit_running_an_older_configuration_is_named_test() {
  let loaded =
    LoadedUnit(
      name: unit,
      temporary: False,
      active_state: "activating",
      sub_state: "auto-restart",
      need_daemon_reload: True,
      exec_start: [string.split(start("", "8622", ""), " ")],
      environment: [#("RUNPOD_SSH_TARGET", "fern-autodl-bj-5090:27464")],
      restarts: 0,
    )
  let recovery =
    LoadedUnit(
      name: "fern-supervisor-bj5090-recovery.service",
      temporary: True,
      active_state: "active",
      sub_state: "running",
      need_daemon_reload: False,
      exec_start: [string.split(start("", "8622", ""), " ")],
      environment: [],
      restarts: 0,
    )
  let findings =
    site_files.check(
      Ok(declared()),
      Observed(..beijing("50300"), loaded: [loaded, recovery]),
      unit,
    )
  assert list.contains(
    findings,
    LoadedOlder(
      unit,
      "RUNPOD_SSH_TARGET",
      "fern-autodl-bj-5090:27464",
      "fern-autodl-bj-5090:50300",
    ),
  )
  assert list.contains(
    findings,
    AlsoServes(
      "fern-supervisor-bj5090-recovery.service",
      True,
      "active/running",
    ),
  )
  assert site_files.describe(LoadedOlder(
      unit,
      "RUNPOD_SSH_TARGET",
      "fern-autodl-bj-5090:27464",
      "fern-autodl-bj-5090:50300",
    ))
    == "systemd runs fern-study-supervisor-autodl-bj-5090.service with RUNPOD_SSH_TARGET fern-autodl-bj-5090:27464, but its files now say fern-autodl-bj-5090:50300; a reload would change what it runs"
}

pub fn what_is_rendered_checks_as_matching_test() {
  let declaration = declared()
  let assert Some(entry) =
    site_files.render_ssh_entry(declaration, "Generated for a test")
  assert entry
    == "# Generated for a test\nHost fern-autodl-bj-5090\n    HostName site-b2.example.invalid\n    User root\n    Port 50300\n    Compression yes\n    RemoteForward 127.0.0.1:8622 127.0.0.1:8621\n    ExitOnForwardFailure yes\n"
  let assert Some(rendered) =
    site_files.render_unit(
      declaration,
      site_files.UnitInputs(
        path: "/home/user/.local/bin:/usr/bin:/bin",
        session_program: "/home/user/study/scripts/connect_runpod_ssh.sh",
        working_directory: "/home/user/study",
        checks_before_start: [],
        provenance: "Generated for a test",
      ),
    )
  assert string.contains(
    rendered,
    "Environment=RUNPOD_CONTROL_PATH=/tmp/fern-beijing-compressed-%%C\n",
  )
  assert !string.contains(rendered, "--study")
  assert !string.contains(rendered, "StandardOutput")
  let findings =
    site_files.check(
      Ok(declaration),
      Observed(
        ssh_include: Some(FileText("~/.ssh/fern-sites.config", entry)),
        ssh_config: Some(FileText(
          "~/.ssh/config",
          "Include ~/.ssh/fern-sites.config\n",
        )),
        unit: Some(FileText("~/.config/systemd/user/" <> unit, rendered)),
        drop_ins: [],
        loaded: [
          LoadedUnit(
            name: unit,
            temporary: False,
            active_state: "active",
            sub_state: "running",
            need_daemon_reload: False,
            exec_start: [],
            environment: [],
            restarts: 0,
          ),
        ],
      ),
      unit,
    )
  assert findings
    == [
      Matches("~/.ssh/fern-sites.config"),
      Matches("~/.config/systemd/user/" <> unit),
    ]
}

pub fn a_declaration_that_cannot_be_read_is_refused_by_name_test() {
  let misspelt =
    string.replace(supervisor, "\"lease_seconds\"", "\"lease_secs\"")
  assert site_files.check(
      site_files.declare(profile, misspelt),
      beijing("50300"),
      unit,
    )
    == [
      Undeclared(
        "the supervisor declaration names fields it does not have: lease_secs",
      ),
    ]
  let other_site =
    string.replace(
      supervisor,
      "\"site\":\"autodl-bj-5090\"",
      "\"site\":\"autodl-4090d\"",
    )
  let assert Error(detail) = site_files.declare(profile, other_site)
  assert detail
    == "the supervisor declaration is for Site autodl-4090d and the profile for autodl-bj-5090"
}

pub fn quoted_words_and_an_empty_environment_are_read_as_systemd_does_test() {
  assert site_files.words("A=\"b c\" 'd e'\tf") == ["A=b c", "d e", "f"]
  let settings =
    site_files.effective([
      FileText("u", "[Service]\nEnvironment=RUNPOD_SSH_TARGET=x:1 OTHER=2\n"),
      FileText(
        "d",
        "[Service]\nEnvironment=\nEnvironment=\"LABEL=two words\"\nExecStart=@-/bin/x a\n",
      ),
    ])
  assert settings.environment == [#("LABEL", "two words")]
  assert settings.exec_start == [["/bin/x", "a"]]
}

pub fn a_config_that_does_not_include_the_rendered_entries_is_named_test() {
  let late =
    Observed(
      ..beijing("50300"),
      ssh_config: Some(FileText(
        "~/.ssh/config",
        "Host other\n    User x\nInclude ~/.ssh/fern-sites.config\n",
      )),
    )
  assert list.contains(
    site_files.check(Ok(declared()), late, unit),
    site_files.NotIncluded("~/.ssh/config"),
  )
  let first =
    Observed(
      ..late,
      ssh_config: Some(FileText(
        "~/.ssh/config",
        "Include\t~/.ssh/fern-sites.config\nHost other\n    User x\n",
      )),
    )
  assert !list.contains(
    site_files.check(Ok(declared()), first, unit),
    site_files.NotIncluded("~/.ssh/config"),
  )
}

pub fn ssh_takes_the_first_value_across_every_matching_block_test() {
  // A wildcard block before the Site's own sets the port first; the
  // Site's block is still the one kept by hand.
  let config =
    "Host fern-*\n    Port=2222\nHost fern-autodl-bj-5090 !fern-other\n\tHostName site-b2.example.invalid\n    User root\n    Port 50300\n    Compression yes\n    RemoteForward 127.0.0.1:8622 127.0.0.1:8621\n    ExitOnForwardFailure yes\n"
  let findings =
    site_files.check(
      Ok(declared()),
      Observed(
        ..beijing("50300"),
        ssh_config: Some(FileText("~/.ssh/config", config)),
      ),
      unit,
    )
  assert list.contains(
    findings,
    Differs("~/.ssh/config", "ssh Port", "50300", "2222"),
  )
  assert list.contains(
    findings,
    KeptByHand("~/.ssh/config", "fern-autodl-bj-5090"),
  )
}

pub fn the_sites_own_unit_restarting_is_named_and_a_recovery_unit_as_declared_is_not_test() {
  let looping =
    LoadedUnit(
      name: unit,
      temporary: False,
      active_state: "activating",
      sub_state: "auto-restart",
      need_daemon_reload: False,
      exec_start: [string.split(start("", "8622", ""), " ")],
      environment: [#("RUNPOD_SSH_TARGET", "fern-autodl-bj-5090:50300")],
      restarts: 0,
    )
  // CHG 2026-09-26 (installed sources retired;
  // docs/programs/2026-09-26-source-roots-stop-being-full-copies slice 4): the
  // recovery unit once differed by leaving out the per-implementation
  // compilers; those are no longer declared, so it runs exactly as declared.
  let recovery =
    LoadedUnit(
      name: "fern-supervisor-bj5090-recovery.service",
      temporary: True,
      active_state: "active",
      sub_state: "running",
      need_daemon_reload: False,
      exec_start: [string.split(start("", "8622", ""), " ")],
      environment: [
        #("RUNPOD_SSH_TARGET", "fern-autodl-bj-5090:50300"),
        #("RUNPOD_COMMAND_TIMEOUT_SECONDS", "1040000"),
        #("RUNPOD_CONTROL_PATH", "/tmp/fern-beijing-compressed-%C"),
      ],
      restarts: 0,
    )
  let findings =
    site_files.check(
      Ok(declared()),
      Observed(..beijing("50300"), loaded: [looping, recovery]),
      unit,
    )
  assert list.contains(
    findings,
    site_files.NotRunning(unit, "activating/auto-restart"),
  )
  // Nothing about the recovery unit's command differs.
  assert list.count(findings, fn(finding) {
      case finding {
        site_files.LoadedDiffers(_, _, _, _) -> True
        _ -> False
      }
    })
    == 0
}

