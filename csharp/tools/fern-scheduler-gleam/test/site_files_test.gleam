const hand_config = "Host fern-autodl-home\n    HostName home.example.invalid\n    User root\n    Port 12223\n\n# new pod, added by hand\nHost fern-autodl-bj-5090\n    HostName site-b2.example.invalid\n    User root\n    Port 50300\n    Compression yes\n    RemoteForward 127.0.0.1:8622 127.0.0.1:8621\n    ExitOnForwardFailure yes\n\nHost fern-runpod-4090\n    HostName 192.0.2.2\n"

pub fn a_matching_hand_block_moves_into_the_rendered_file_test() {
  let update =
    site_files.update_ssh([declared()], hand_config, "Generated for a test")
  assert update.include_added
  assert update.removed == ["fern-autodl-bj-5090"]
  assert update.kept == []
  assert update.config_text
    == "Include ~/.ssh/fern-sites.config\n\nHost fern-autodl-home\n    HostName home.example.invalid\n    User root\n    Port 12223\n\n# new pod, added by hand\n\nHost fern-runpod-4090\n    HostName 192.0.2.2\n"
  assert string.contains(
    update.include_text,
    "Host fern-autodl-bj-5090\n    HostName site-b2.example.invalid\n",
  )
  // Checked after the update, the Site's SSH files match and are read.
  let findings =
    site_files.check(
      Ok(declared()),
      Observed(
        ..beijing("50300"),
        ssh_include: Some(FileText(
          "~/.ssh/fern-sites.config",
          update.include_text,
        )),
        ssh_config: Some(FileText("~/.ssh/config", update.config_text)),
      ),
      unit,
    )
  assert list.contains(findings, Matches("~/.ssh/fern-sites.config"))
  assert !list.any(findings, fn(finding) {
    case finding {
      KeptByHand(_, _) | site_files.NotIncluded(_) -> True
      _ -> False
    }
  })
}

pub fn a_hand_block_with_more_than_the_declaration_is_kept_test() {
  let with_key =
    string.replace(
      hand_config,
      "    ExitOnForwardFailure yes\n",
      "    ExitOnForwardFailure yes\n    IdentityFile ~/.ssh/other\n",
    )
  let update =
    site_files.update_ssh([declared()], with_key, "Generated for a test")
  assert update.removed == []
  let assert [#("fern-autodl-bj-5090", reason)] = update.kept
  assert string.contains(reason, "identityfile ~/.ssh/other")
  let shared =
    string.replace(
      hand_config,
      "Host fern-autodl-bj-5090\n",
      "Host fern-autodl-bj-5090 old-name\n",
    )
  assert site_files.update_ssh([declared()], shared, "t").kept
    == [#("fern-autodl-bj-5090", "its Host line also names other hosts")]
}

pub fn an_updated_config_is_left_as_it_is_test() {
  let settled = "Include ~/.ssh/fern-sites.config\n\nHost other\n    User x\n"
  let update = site_files.update_ssh([declared()], settled, "t")
  assert !update.include_added
  assert update.config_text == settled
  assert update.removed == []
}

