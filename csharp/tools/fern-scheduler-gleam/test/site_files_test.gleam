pub fn the_update_waits_until_the_sites_own_unit_is_stopped_test() {
  // A unit in its restart loop reads as running part of the time; either way
  // its next start by itself would run the new configuration.
  let looping =
    Observed(..beijing("50300"), loaded: [
      own("activating", "auto-restart", 1187),
    ])
  let assert Error(said) =
    site_files.update_unit(declared(), looping, inputs(), True)
  assert string.contains(
    said,
    "is activating/auto-restart, restarted 1187 time(s)",
  )
  assert string.contains(said, "this update never starts a unit")
  let running =
    Observed(..beijing("50300"), loaded: [own("active", "running", 3)])
  let assert Error(_) =
    site_files.update_unit(declared(), running, inputs(), True)
  // Stopped, or failed, it may be written.
  let stopped =
    Observed(..beijing("50300"), loaded: [own("inactive", "dead", 0)])
  let assert Ok(_) = site_files.update_unit(declared(), stopped, inputs(), True)
  let failed =
    Observed(..beijing("50300"), loaded: [own("failed", "failed", 4)])
  let assert Ok(_) = site_files.update_unit(declared(), failed, inputs(), True)
}

