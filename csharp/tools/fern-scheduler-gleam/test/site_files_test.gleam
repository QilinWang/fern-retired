pub fn a_second_active_supervisor_refuses_the_update_by_name_test() {
  let observed = Observed(..beijing("50300"), loaded: [recovery("active")])
  let assert Error(said) =
    site_files.update_unit(declared(), observed, inputs(), True)
  assert string.contains(
    said,
    "is served by fern-supervisor-bj5090-recovery.service (created at run time, active/running)",
  )
  assert string.contains(said, "nothing is written")
  // A stopped recovery unit is not a second supervisor.
  let stopped = Observed(..beijing("50300"), loaded: [recovery("inactive")])
  let assert Ok(_) = site_files.update_unit(declared(), stopped, inputs(), True)
}

pub fn drop_ins_refuse_the_update_unless_they_are_to_be_removed_test() {
  let assert Error(said) =
    site_files.update_unit(declared(), beijing("50300"), inputs(), False)
  assert string.contains(said, "3 drop-in(s) change the unit")
  assert string.contains(said, "--remove-extra")
  let assert Ok(update) =
    site_files.update_unit(declared(), beijing("50300"), inputs(), True)
  assert update.write
  assert update.reload
  assert update.remove
    == [
      unit <> ".d/oracle-neighbours.conf",
      unit <> ".d/zzzz-beta-nll.conf",
      unit <> ".d/zzzzz-head-splines.conf",
    ]
  assert string.contains(
    update.text,
    "ExecStartPre=/home/user/bin/fern-run check-site-files --before-start\n",
  )
}

